SECRET_KEY=replace-with-a-long-random-string
# Use the postgresql+psycopg:// prefix (psycopg 3). Plain postgresql:// makes SQLAlchemy look for psycopg2.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/nexora_dev
# Must end in _test. The migration tests use a second database, <name>_schema_test
# (nexora_schema_test here), created once by you; see README "Running the tests".
TEST_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/nexora_test
FLASK_DEBUG=1
# development or production. In production the app refuses to start with debug
# on, memory:// rate limits, a short or placeholder SECRET_KEY, or a * origin.
APP_ENV=development
# Exact browser origins allowed to call the API, comma-separated
# (e.g. http://localhost:5173). Empty means no cross-origin access. Never *.
CORS_ORIGINS=
# Reverse proxies in front of the app (0 if none); needed for per-IP rate limits
TRUSTED_PROXIES=0
# Rate-limit storage. Production: redis://:PASSWORD@host:6379/0 (rediss:// for TLS;
# URL-encode special characters in the password). memory:// is for local dev only.
RATELIMIT_STORAGE_URI=memory://
# Email for address verification. log = print the link in the server log (local
# only). Production needs smtp plus MAIL_SERVER, MAIL_FROM and credentials.
# Brevo: MAIL_BACKEND=smtp, MAIL_SERVER=smtp-relay.brevo.com, MAIL_PORT=587,
# MAIL_USERNAME = the SMTP login and MAIL_PASSWORD = the SMTP key from Brevo's
# SMTP & API page (not the API key). MAIL_FROM must be a verified Brevo sender.
MAIL_BACKEND=log
MAIL_FROM=no-reply@nexora.local
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Where the verification link points (the frontend page that calls /auth/verify-email)
FRONTEND_URL=http://localhost:5173

# Help bot. Free key: https://aistudio.google.com/apikey . Empty = bot answers 503.
# Set ASSISTANT_DAILY_CAP below the free requests per day shown in AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ASSISTANT_TIMEOUT=8
ASSISTANT_DAILY_CAP=800

# M-Pesa STK push. DARAJA_ENV is sandbox (default) or production. Sandbox uses the
# shared keys below. With APP_ENV=production the app starts with DARAJA_ENABLED=1
# only if DARAJA_ENV=production, DARAJA_CALLBACK_URL is https and ends with the
# token, and DARAJA_ENCRYPTION_KEY is set; then each SACCO's own saved credentials
# are used and the shared keys below are never read. See the Deployment section of README.md.
DARAJA_ENV=sandbox
DARAJA_ENABLED=0
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_PASSKEY=
DARAJA_SHORTCODE=
# Encrypts each SACCO's own Daraja credentials in the database. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it out of git. Lose it and each SACCO admin must save their credentials again.
DARAJA_ENCRYPTION_KEY=
# Public URL Safaricom posts to: https://<your host>/api/v1/daraja/callback/<DARAJA_CALLBACK_TOKEN>
DARAJA_CALLBACK_URL=
DARAJA_CALLBACK_TOKEN=
